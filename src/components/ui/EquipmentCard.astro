---
const { title, desc, icon, code = "EQUIPMENT" } = Astro.props;
---

<div class="card p-6 lg:p-7 h-full flex flex-col justify-between hover:border-accent/40 transition-all duration-300 group">
  <div>
    <div class="flex items-center justify-between gap-2 mb-4">
      <span class="badge-tech font-mono-tech">
        {code}
      </span>
      <i data-lucide={icon} class="w-4 h-4 text-accent/80 group-hover:text-accent transition-colors"></i>
    </div>

    <h3 class="text-lg font-bold text-text-primary mb-2 group-hover:text-accent transition-colors">
      {title}
    </h3>

    <p class="text-sm leading-relaxed text-text-secondary">
      {desc}
    </p>
  </div>

  <div class="pt-4 mt-5 border-t border-border/70 flex items-center justify-between text-xs font-mono-tech text-text-muted">
    <span>NOWE & UŻYWANE</span>
    <span class="text-accent font-semibold">DOSTAWA PL / EU</span>
  </div>
</div>
