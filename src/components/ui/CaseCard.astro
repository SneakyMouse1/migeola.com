---
const {
  img,
  from,
  to,
  fromCode = "eu",
  toCode = "eu",
  title,
  count,
  transport,
  client,
  duration,
  desc,
} = Astro.props;
---

<article class="card overflow-hidden flex flex-col h-full group hover:border-accent/40 transition-all duration-300 shadow-sm">
  <!-- Top Route Manifest Bar -->
  <div class="px-4 py-2.5 flex items-center justify-between border-b border-border/70 bg-bg-surface/60 text-xs font-mono-tech">
    <div class="flex items-center gap-2 font-semibold text-text-primary truncate">
      <span class={`fi fi-${fromCode} rounded-xs shrink-0 shadow-xs`}></span>
      <span class="tracking-tight truncate">{from}</span>
      <span class="text-accent font-bold shrink-0">➔</span>
      <span class={`fi fi-${toCode} rounded-xs shrink-0 shadow-xs`}></span>
      <span class="tracking-tight truncate">{to}</span>
    </div>
    <span class="badge-tech badge-tech--accent py-0.5 px-2 shrink-0">
      {duration}
    </span>
  </div>

  <!-- Photo / Image container -->
  <div class="relative w-full aspect-16/10 overflow-hidden bg-bg-surface">
    {
      img ? (
        <img
          src={img}
          alt={title}
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
          loading="lazy"
        />
      ) : (
        <div class="w-full h-full flex items-center justify-center bg-bg-surface text-text-muted">
          <i data-lucide="package" class="w-8 h-8 opacity-40" />
        </div>
      )
    }
    <!-- Badge overlay on photo -->
    <div class="absolute bottom-2.5 left-2.5 right-2.5 flex items-center justify-between pointer-events-none gap-2">
      <span class="badge-tech py-0.5 px-2 bg-bg-base/90 backdrop-blur-md border-border/80 text-text-primary font-semibold truncate">
        {count}
      </span>
      <span class="badge-tech py-0.5 px-2 bg-bg-base/90 backdrop-blur-md border-border/80 text-accent font-semibold uppercase truncate">
        {transport}
      </span>
    </div>
  </div>

  <!-- Content -->
  <div class="p-5 flex flex-col gap-3 flex-1">
    <h3 class="text-base lg:text-lg font-bold text-text-primary group-hover:text-accent transition-colors leading-snug">
      {title}
    </h3>

    {desc && (
      <p class="text-xs leading-relaxed text-text-secondary line-clamp-3">
        {desc}
      </p>
    )}

    <div class="mt-auto pt-3.5 border-t border-border/60 flex items-center justify-between text-xs text-text-muted gap-2">
      <div class="flex items-center gap-1.5 truncate">
        <i data-lucide="building-2" class="w-3.5 h-3.5 text-accent shrink-0" aria-hidden="true"></i>
        <span class="truncate font-medium text-text-secondary">{client}</span>
      </div>
      <span class="font-mono-tech text-xs text-text-muted uppercase shrink-0">DELIVERED</span>
    </div>
  </div>
</article>
