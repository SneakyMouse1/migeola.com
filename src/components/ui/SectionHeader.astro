---
const {
  label,
  title,
  subtitle,
  align = "center",
  class: className = "",
} = Astro.props;
const alignClass = align === "left" ? "text-left" : "text-center mx-auto";
---

<div class={`max-w-3xl mb-12 lg:mb-16 ${alignClass} ${className}`}>
  {
    label && (
      <div class={`mb-3 ${align === "left" ? "flex justify-start" : "flex justify-center"}`}>
        <span class="inline-flex items-center text-xs font-semibold tracking-wider uppercase text-accent font-mono-tech px-2.5 py-1 rounded bg-accent/10 border border-accent/20">
          {label}
        </span>
      </div>
    )
  }
  {
    title && (
      <h2
        class="text-3xl md:text-4xl lg:text-4xl font-bold mb-4 leading-tight tracking-tight text-text-primary"
      >
        {title}
      </h2>
    )
  }
  {
    subtitle && (
      <p class="text-base md:text-lg leading-relaxed text-text-secondary max-w-2xl mx-auto">
        {subtitle}
      </p>
    )
  }
</div>
