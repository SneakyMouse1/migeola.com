---
const { title, items = [], icon } = Astro.props;
---

<div class="card p-6 flex flex-col gap-4 h-full">
  <!-- Icon -->
  <div
    class="w-10 h-10 rounded-lg flex items-center justify-center shrink-0 bg-accent-glow border border-accent/20"
    aria-hidden="true"
  >
    <i data-lucide={icon} class="w-5 h-5 text-accent"></i>
  </div>

  <!-- Title -->
  <h3 class="text-base font-semibold text-text-primary">
    {title}
  </h3>

  <!-- Vertical bullet list -->
  {items.length > 0 && (
    <ul class="flex flex-col gap-1.5">
      {items.map((item) => (
        <li class="flex items-center gap-2 text-sm text-text-secondary">
          <span
            class="w-1 h-1 rounded-full shrink-0 bg-accent/60"
            aria-hidden="true"
          ></span>
          {item}
        </li>
      ))}
    </ul>
  )}
</div>
