---
import Button from "./ui/Button.astro";
import { Sun, Moon } from "@lucide/astro";

const { lang, tr, plUrl, enUrl } = Astro.props;

const currentPath = Astro.url.pathname.replace(/\/$/, "");

// 1:1 route map between Polish and English subpages
const routeMapPLtoEN: Record<string, string> = {
  "": "/en",
  "/polityka-prywatnosci": "/en/privacy-policy",
  "/regulamin": "/en/terms-of-use",
  "/polityka-cookies": "/en/cookie-policy",
};

const routeMapENtoPL: Record<string, string> = {
  "/en": "/",
  "/en/privacy-policy": "/polityka-prywatnosci",
  "/en/terms-of-use": "/regulamin",
  "/en/cookie-policy": "/polityka-cookies",
};

let plHref = "/";
let enHref = "/en";

if (plUrl && enUrl) {
  plHref = plUrl.replace("https://migeola.com", "") || "/";
  enHref = enUrl.replace("https://migeola.com", "") || "/en";
} else if (lang === "pl") {
  plHref = currentPath || "/";
  enHref = routeMapPLtoEN[currentPath] ?? "/en";
} else {
  enHref = currentPath || "/en";
  plHref = routeMapENtoPL[currentPath] ?? "/";
}

const anchors = {
  about: "#about",
  equipment: "#equipment",
  cases: "#cases",
  contact: "#contact",
};

const themeToggleClass =
  "w-10 h-10 flex items-center justify-center rounded-xl border border-border bg-bg-surface/80 hover:bg-bg-card hover:border-border-hover transition-all duration-200 cursor-pointer select-none";
---

<header
  class="sticky top-0 z-50 backdrop-blur-md border-b bg-bg-header border-border"
>
  <nav class="max-w-7xl mx-auto px-6 lg:px-12">
    <div class="flex items-center justify-between h-16 lg:h-20">
      <a href={lang === "pl" ? "/" : "/en"} class="flex items-center gap-3">
        <img src="/migeola-dark.png" alt="Migeola" class="w-32 logo-light" />
        <img src="/migeola-light.png" alt="Migeola" class="w-32 logo-dark" />
      </a>

      <div class="hidden lg:flex items-center gap-8">
        <a href={anchors.about} class="text-text-secondary text-sm font-medium transition-colors duration-200 hover:text-text-primary">{tr.nav_about}</a>
        <a href={anchors.equipment} class="text-text-secondary text-sm font-medium transition-colors duration-200 hover:text-text-primary">{tr.nav_equipment}</a>
        <a href={anchors.cases} class="text-text-secondary text-sm font-medium transition-colors duration-200 hover:text-text-primary">{tr.nav_cases}</a>
        <a href={anchors.contact} class="text-text-secondary text-sm font-medium transition-colors duration-200 hover:text-text-primary">{tr.nav_contact}</a>
      </div>

      <div class="hidden lg:flex items-center gap-3">
        <!-- Segmented Language Switcher -->
        <div class="inline-flex items-center p-1 rounded-xl border border-border bg-bg-surface/80 select-none">
          <a
            href={plHref}
            data-astro-prefetch="load"
            class={`lang-switch-btn px-2.5 py-1 text-xs font-mono-tech font-bold rounded-lg transition-all duration-200 ${
              lang === "pl"
                ? "bg-bg-card text-text-primary shadow-sm border border-border/80 pointer-events-none cursor-default"
                : "text-text-muted hover:text-text-primary cursor-pointer"
            }`}
            aria-label="Język polski"
          >
            PL
          </a>
          <a
            href={enHref}
            data-astro-prefetch="load"
            class={`lang-switch-btn px-2.5 py-1 text-xs font-mono-tech font-bold rounded-lg transition-all duration-200 ${
              lang === "en"
                ? "bg-bg-card text-text-primary shadow-sm border border-border/80 pointer-events-none cursor-default"
                : "text-text-muted hover:text-text-primary cursor-pointer"
            }`}
            aria-label="English language"
          >
            EN
          </a>
        </div>

        <!-- Tinted Theme Switcher -->
        <button
          id="theme-toggle"
          aria-label="Toggle theme"
          class={themeToggleClass}
        >
          <Moon class="w-4 h-4 icon-moon pointer-events-none stroke-[2]" />
          <Sun class="w-4 h-4 icon-sun pointer-events-none stroke-[2]" />
        </button>

        <!-- CTA Button with Arrow -->
        <Button href={anchors.contact} variant="primary" class="px-5 py-2.5 rounded-xl group flex items-center justify-center gap-1.5 shadow-md shadow-accent/20">
          <span>{tr.nav_cta}</span>
          <span class="inline-block transition-transform duration-200 group-hover:translate-x-1 font-bold">→</span>
        </Button>
      </div>

      <div class="flex items-center gap-2.5 lg:hidden">
        <!-- Mobile Segmented Language Switcher -->
        <div class="inline-flex items-center p-0.5 rounded-xl border border-border bg-bg-surface/80 select-none">
          <a
            href={plHref}
            data-astro-prefetch="load"
            class={`lang-switch-btn px-2 py-1 text-xs font-mono-tech font-bold rounded-lg transition-all duration-200 ${
              lang === "pl"
                ? "bg-bg-card text-text-primary shadow-sm border border-border/80 pointer-events-none cursor-default"
                : "text-text-muted hover:text-text-primary cursor-pointer"
            }`}
            aria-label="Język polski"
          >
            PL
          </a>
          <a
            href={enHref}
            data-astro-prefetch="load"
            class={`lang-switch-btn px-2 py-1 text-xs font-mono-tech font-bold rounded-lg transition-all duration-200 ${
              lang === "en"
                ? "bg-bg-card text-text-primary shadow-sm border border-border/80 pointer-events-none cursor-default"
                : "text-text-muted hover:text-text-primary cursor-pointer"
            }`}
            aria-label="English language"
          >
            EN
          </a>
        </div>

        <!-- Mobile Tinted Theme Switcher -->
        <button
          id="theme-toggle-mobile"
          aria-label="Toggle theme"
          class={themeToggleClass}
        >
          <Moon class="w-4 h-4 icon-moon pointer-events-none stroke-[2]" />
          <Sun class="w-4 h-4 icon-sun pointer-events-none stroke-[2]" />
        </button>

        <label
          for="menu-toggle"
          class="cursor-pointer p-2 -mr-2"
          aria-label="Menu"
        >
          <span class="block w-6 h-0.5 bg-text-primary my-1 transition-colors duration-200"></span>
          <span class="block w-6 h-0.5 bg-text-primary my-1 transition-colors duration-200"></span>
          <span class="block w-6 h-0.5 bg-text-primary my-1 transition-colors duration-200"></span>
        </label>
      </div>
    </div>

    <input type="checkbox" id="menu-toggle" class="peer sr-only" />

    <div
      id="mobile-menu"
      class="peer-checked:block hidden absolute top-full left-0 right-0 z-50 border-b shadow-lg bg-bg-surface border-border"
    >
      <div class="px-6 py-6 flex flex-col gap-4">
        <a href={anchors.about} class="text-text-secondary text-base font-medium py-2 border-b border-border transition-colors duration-200 hover:text-text-primary">{tr.nav_about}</a>
        <a href={anchors.equipment} class="text-text-secondary text-base font-medium py-2 border-b border-border transition-colors duration-200 hover:text-text-primary">{tr.nav_equipment}</a>
        <a href={anchors.cases} class="text-text-secondary text-base font-medium py-2 border-b border-border transition-colors duration-200 hover:text-text-primary">{tr.nav_cases}</a>
        <a href={anchors.contact} class="text-text-secondary text-base font-medium py-2 border-b border-border transition-colors duration-200 hover:text-text-primary">{tr.nav_contact}</a>
        <div class="pt-2">
          <Button href={anchors.contact} variant="primary" class="w-full flex items-center justify-center gap-1.5 group">
            <span>{tr.nav_cta}</span>
            <span class="inline-block transition-transform duration-200 group-hover:translate-x-1 font-bold">→</span>
          </Button>
        </div>
      </div>
    </div>
  </nav>
</header>

<style>
  .icon-moon {
    display: block;
    color: #60a5fa;
    filter: drop-shadow(0 0 6px rgba(96, 165, 250, 0.45));
  }
  .icon-sun {
    display: none;
    color: #f59e0b;
    filter: drop-shadow(0 0 6px rgba(245, 158, 11, 0.45));
  }

  :global([data-theme="light"]) .icon-moon {
    display: none;
  }
  :global([data-theme="light"]) .icon-sun {
    display: block;
  }
  :global([data-theme="dark"]) .icon-moon {
    display: block;
  }
  :global([data-theme="dark"]) .icon-sun {
    display: none;
  }
</style>

<script>
  import { initThemeToggle } from "../scripts/theme.js";
  import { initNavigation } from "../scripts/navigation.js";

  function setupHeader() {
    initThemeToggle();
    initNavigation();
  }

  setupHeader();
  document.addEventListener("astro:page-load", setupHeader);
</script>
