---
import SectionHeader from "../ui/SectionHeader.astro";
import Button from "../ui/Button.astro";
import EquipmentCard from "../ui/EquipmentCard.astro";

const { tr, lang = 'pl' } = Astro.props;
const isEN = lang === 'en' || tr.nav_about === 'About';

const steps = [
  {
    n: 1,
    icon: 'search',
    tagPL: 'ETAP // WERYFIKACJA',
    tagEN: 'STEP // SOURCING',
    titlePL: 'Wyszukanie dostawcy',
    titleEN: 'Supplier Sourcing',
    descPL: 'Weryfikacja bazy producentów, audyt stanu technicznego maszyn i historii serwisowej.',
    descEN: 'Supplier network verification, machine technical audit and service history check.',
  },
  {
    n: 2,
    icon: 'handshake',
    tagPL: 'ETAP // TRANSAKCJA',
    tagEN: 'STEP // TRANSACTION',
    titlePL: 'Zakup & Negocjacje',
    titleEN: 'Purchase & Negotiations',
    descPL: 'Bezpośrednie negocjacje handlowe, zabezpieczenie umowy zakupu i dokumentów eksportowych.',
    descEN: 'Direct commercial negotiations, purchase agreement and export documentation.',
  },
  {
    n: 3,
    icon: 'truck',
    tagPL: 'ETAP // LOGISTYKA',
    tagEN: 'STEP // LOGISTICS',
    titlePL: 'Dostawa na miejsce',
    titleEN: 'Delivery on site',
    descPL: 'Organizacja frachtu, pilotażu ponadgabarytowego, cła i rozładunku na placu zamawiającego.',
    descEN: 'Freight organization, oversized cargo permits, customs and site offloading.',
  },
];

function getStepTitle(step: any, tr: any) {
  const key = `eq_step_${step.n}_title`;
  if (tr[key]) return tr[key];
  return isEN ? step.titleEN : step.titlePL;
}

const cards = [
  { titleKey: 'eq_1_title', descKey: 'eq_1_desc', icon: 'tractor', code: 'AGRI_TECH' },
  { titleKey: 'eq_2_title', descKey: 'eq_2_desc', icon: 'factory', code: 'INDUSTRY' },
  { titleKey: 'eq_3_title', descKey: 'eq_3_desc', icon: 'car', code: 'SPECIAL_VEHICLES' },
  { titleKey: 'eq_4_title', descKey: 'eq_4_desc', icon: 'hard-hat', code: 'HEAVY_BUILD' },
];
---

<section id="equipment" class="py-20 lg:py-28 bg-bg-base">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">

    <div data-reveal>
      <SectionHeader
        label={tr.equipment_label}
        title={tr.equipment_title}
        subtitle={tr.equipment_p1}
        align="center"
      />
    </div>

    <!-- Sourcing Process -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-16 border border-border/80 rounded-xl bg-bg-card/40 p-4 lg:p-6" data-reveal>
      {steps.map((step) => (
        <div class="p-5 rounded-lg border border-border/60 bg-bg-surface/60 flex flex-col justify-between hover:border-accent/30 transition-colors">
          <div class="flex items-center justify-between gap-2 mb-4">
            <span class="badge-tech badge-tech--accent">
              {isEN ? step.tagEN : step.tagPL}
            </span>
            <i data-lucide={step.icon} class="w-4 h-4 text-accent/70"></i>
          </div>

          <div>
            <h3 class="text-base font-bold text-text-primary mb-1.5">
              {getStepTitle(step, tr)}
            </h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              {isEN ? step.descEN : step.descPL}
            </p>
          </div>
        </div>
      ))}
    </div>

    <!-- Fleet Categories -->
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4 mb-12 items-stretch">
      {cards.map(({ titleKey, descKey, icon, code }, i) => (
        <div data-reveal data-delay={`${i * 100}`} class="h-full">
          <EquipmentCard
            title={tr[titleKey]}
            desc={tr[descKey]}
            icon={icon}
            code={code}
          />
        </div>
      ))}
    </div>


    <div class="flex justify-center" data-reveal>
      <Button href="#contact" variant="primary">
        {tr.equipment_cta}
        <i data-lucide="arrow-right" class="w-4 h-4" aria-hidden="true"></i>
      </Button>
    </div>

  </div>
</section>
