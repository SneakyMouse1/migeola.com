---
import Button from "../ui/Button.astro";
import SectionHeader from "../ui/SectionHeader.astro";

const { tr } = Astro.props;
---

<section id="equipment-sales" class="py-20 lg:py-28 bg-bg-surface">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <!-- Top: headline + intro -->
    <div class="grid lg:grid-cols-2 gap-12 items-end mb-14" data-reveal>
      <div>
        <SectionHeader
          label={tr.eq_sales_label}
          title={tr.eq_sales_title}
          align="left"
          class="mb-6"
        />
        <p
          class="text-xl lg:text-2xl font-medium leading-relaxed text-text-primary"
        >
          {tr.eq_sales_seo_text}
        </p>
      </div>
      <p class="text-sm leading-relaxed lg:pb-4 text-text-secondary">
        {tr.eq_sales_p1}
        <br /><br />
        {tr.eq_sales_p2}
      </p>
    </div>

    <!-- Category cards -->
    <div
      class="grid grid-cols-1 md:grid-cols-3 gap-4 overflow-hidden rounded-xl mb-4 border-border"
      data-reveal
      data-delay="100"
    >
      {
        tr.eq_sales_categories.map((cat: any, i: number) => (
          <div class="card rounded-none border-0 border-b sm:border-b-0 sm:border-r border-border last:border-r-0 last:border-b-0 p-6 lg:p-7">
            <p class="text-sm font-bold mb-4 text-accent tracking-[0.14em]">
              {String(i + 1).padStart(2, "0")} / {cat.tag}
            </p>

            <h3 class="text-base font-bold mb-3 pb-3 border-b border-border text-text-primary">
              {cat.title}
            </h3>

            <ul class="flex flex-col gap-2">
              {cat.items.map((item: string) => (
                <li class="flex items-baseline gap-2.5 text-sm text-text-secondary">
                  <span class="text-text-muted shrink-0">—</span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <!-- Bottom: pitch + sidebar -->
    <div
      class="grid grid-cols-1 lg:grid-cols-[1fr_240px] gap-4"
      data-reveal
      data-delay="200"
    >
      <!-- Pitch -->
      <div class="card p-7 lg:p-8">
        <h3 class="text-base font-bold mb-3 text-text-primary">
          {tr.eq_sales_pitch_title}
        </h3>
        <p class="text-sm leading-relaxed mb-6 text-text-secondary">
          {tr.eq_sales_p3}
          {" "}
          {tr.eq_sales_p4}
        </p>

        <Button href="#contact" variant="primary">
          {tr.eq_sales_cta}
          <i data-lucide="arrow-right" class="w-4 h-4" aria-hidden="true"></i>
        </Button>

        <p class="mt-3 text-xs text-text-muted">
          {tr.eq_sales_cta_note}
        </p>
      </div>

      <!-- Sidebar -->
      <div class="flex flex-col gap-4">
        <div class="card p-5 flex-1">
          <p
            class="text-xs font-bold uppercase mb-3 text-accent tracking-label"
          >
            {tr.eq_sales_target_title}
          </p>
          <ul class="flex flex-col gap-1.5">
            {
              tr.eq_sales_target_items.map((item: string) => (
                <li class="text-sm rounded-md px-2.5 py-1.5 text-text-secondary bg-bg-base">
                  {item}
                </li>
              ))
            }
          </ul>
        </div>

        <div class="card p-5">
          <p
            class="text-xs font-bold uppercase mb-3 text-accent tracking-label"
          >
            {tr.eq_sales_markets_title}
          </p>
          <div class="flex flex-wrap gap-2">
            {
              tr.eq_sales_markets.map((m: string) => (
                <span class="text-xs font-semibold rounded px-2.5 py-1 text-accent bg-accent-glow">
                  {m}
                </span>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
