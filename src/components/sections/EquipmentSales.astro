---
import Button from "../ui/Button.astro";
import SectionHeader from "../ui/SectionHeader.astro";

const { tr, lang = "pl" } = Astro.props;

const isEN = lang === "en" || tr.nav_about === "About";

// Category division configurations
const categoryMeta = [
  {
    code: isEN ? "HEAVY DUTY" : "SPRZĘT CIĘŻKI",
    badgeClass: "badge-tech--accent",
    icon: "truck",
    spec: isEN ? "Tracked & Wheeled / CE" : "Kołowe & Gąsienicowe / CE",
    availability: isEN ? "IN STOCK & SOURCING" : "DOSTĘPNE & NA ZAMÓWIENIE",
  },
  {
    code: isEN ? "AGRI-TECH" : "AGRO-MASZYNY",
    badgeClass: "badge-tech--amber",
    icon: "tractor",
    spec: isEN ? "Up to 500+ HP / EU Homologation" : "Do 500+ KM / Homologacja EU",
    availability: isEN ? "CERTIFIED FLEET" : "FLOTA CERTYFIKOWANA",
  },
  {
    code: isEN ? "INDUSTRIAL" : "PRZEMYSŁ",
    badgeClass: "badge-tech",
    icon: "settings",
    spec: isEN ? "OEM Components & Plant Lines" : "Części OEM & Linie Fabryczne",
    availability: isEN ? "CUSTOM SOURCING" : "DEDYKOWANY SOURCING",
  },
];

const workflow = isEN
  ? [
      {
        tag: "// AUDIT & INSPECTION",
        title: "Audit & Pre-Inspection",
        desc: "Comprehensive check of operating hours, hydraulics, undercarriage and technical history prior to contract signing.",
      },
      {
        tag: "// DIRECT CONTRACT",
        title: "Direct Procurement",
        desc: "Direct supplier negotiations in Europe and Asia, transparent purchasing agreements and secured payments.",
      },
      {
        tag: "// CUSTOMS COMPLIANCE",
        title: "Customs & Formalities",
        desc: "Complete handling of export/import declarations, EUR.1 / CE conformity and smooth border clearance.",
      },
      {
        tag: "// TURNKEY LOGISTICS",
        title: "Door-to-Door Delivery",
        desc: "Low-bed road haulage or Ro-Ro sea freight with dedicated site offloading at your yard or facility.",
      },
    ]
  : [
      {
        tag: "// AUDYT & INSPEKCJA",
        title: "Weryfikacja techniczna",
        desc: "Kompleksowy audyt motogodzin, stanu hydrauliki, podwozia i historii serwisowej przed zawarciem umowy.",
      },
      {
        tag: "// BEZPOŚREDNI ZAKUP",
        title: "Kontrakt bez pośredników",
        desc: "Bezpośrednie zakupy od sprawdzonych dealerów w UE i Azji, transparentne rozliczenie i gwarancja stałej ceny.",
      },
      {
        tag: "// ODPRAWA CELNA",
        title: "Obsługa celno-skarbowa",
        desc: "Przygotowanie dokumentów przewozowych, procedury celne, deklaracje zgodności CE i homologacje.",
      },
      {
        tag: "// DOSTAWA POD KLUCZ",
        title: "Dostawa door-to-door",
        desc: "Transport niskopodwoziowy lub fracht morski z bezpośrednim rozładunkiem na placu budowy lub w gospodarstwie.",
      },
    ];

const targetIcons = ["hard-hat", "tractor", "warehouse", "factory"];

const sourcingMarkets = isEN
  ? [
      { name: "Europe", scope: "Germany, Netherlands, Italy, Poland", tag: "EU / CE" },
      { name: "Asia", scope: "China, Japan, South Korea", tag: "OEM FACTORY" },
      { name: "Global", scope: "USA, Turkey, UAE", tag: "IMPORT" },
    ]
  : [
      { name: "Europa", scope: "Niemcy, Holandia, Włochy, Polska", tag: "RYNEK UE / CE" },
      { name: "Azja", scope: "Chiny, Japonia, Korea Południowa", tag: "PRODUCENCI OEM" },
      { name: "Globalnie", scope: "USA, Turcja, Bliski Wschód", tag: "IMPORT" },
    ];
---

<section id="equipment-sales" class="py-20 lg:py-28 bg-bg-surface">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <!-- Header: Label, Title and Executive Brief -->
    <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-end mb-14" data-reveal>
      <div>
        <SectionHeader
          label={tr.eq_sales_label}
          title={tr.eq_sales_title}
          align="left"
          class="mb-5"
        />
        <p class="text-xl lg:text-2xl font-medium leading-relaxed text-text-primary">
          {tr.eq_sales_seo_text}
        </p>
      </div>

      <div class="space-y-4 lg:pb-2">
        <p class="text-sm leading-relaxed text-text-secondary">
          {tr.eq_sales_p1} {tr.eq_sales_p2}
        </p>

        <!-- Technical Capabilities Bar -->
        <div class="flex flex-wrap gap-2 pt-2 border-t border-border/70">
          <span class="badge-tech">
            {isEN ? "NEW & CERTIFIED PRE-OWNED" : "NOWE & PO INSPEKCJI TECHNICZNEJ"}
          </span>
          <span class="badge-tech">
            {isEN ? "FULL CUSTOMS CLEARANCE" : "KOMPLEKSOWA OBSŁUGA CELNA"}
          </span>
          <span class="badge-tech">
            {isEN ? "MULTIMODAL FREIGHT" : "TRANSPORT PONADGABARYTOWY"}
          </span>
        </div>
      </div>
    </div>

    <!-- Equipment Divisions -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-8" data-reveal data-delay="100">
      {
        tr.eq_sales_categories.map((cat: any, i: number) => {
          const meta = categoryMeta[i] || categoryMeta[0];
          return (
            <div class="card p-7 lg:p-8 flex flex-col justify-between hover:border-accent/40 transition-all duration-300 group">
              <div>
                <div class="flex items-center justify-between gap-3 mb-5 pb-3 border-b border-border/70">
                  <span class={`badge-tech ${meta.badgeClass} font-mono-tech`}>
                    {meta.code}
                  </span>
                  <div class="flex items-center gap-2">
                    <span class="text-xs font-mono-tech text-text-muted uppercase">
                      {cat.tag}
                    </span>
                    <i data-lucide={cat.icon || meta.icon} class="w-4 h-4 text-accent/80 group-hover:text-accent transition-colors" aria-hidden="true" />
                  </div>
                </div>

                <h3 class="text-xl font-bold text-text-primary mb-4 group-hover:text-accent transition-colors">
                  {cat.title}
                </h3>

                <ul class="space-y-3 mb-6">
                  {cat.items.map((item: string) => (
                    <li class="flex items-center gap-3 text-sm text-text-secondary">
                      <span class="w-1.5 h-1.5 rounded-full bg-accent/70 shrink-0" />
                      <span class="font-medium">{item}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="pt-4 border-t border-border/70 flex items-center justify-between text-xs font-mono-tech">
                <span class="text-text-muted">{meta.spec}</span>
                <span class="text-accent font-semibold">{meta.availability}</span>
              </div>
            </div>
          );
        })
      }
    </div>

    <!-- Full-Cycle Procurement Framework -->
    <div class="card p-7 lg:p-10 border-border/90 bg-bg-card/70 shadow-lg" data-reveal data-delay="150">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-stretch">

        <!-- Left: Execution Protocol (7 cols) -->
        <div class="lg:col-span-7 flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-3 mb-4">
              <span class="badge-tech badge-tech--accent font-mono-tech">
                {isEN ? "// END-TO-END SOURCING" : "// PEŁEN CYKL OBSŁUGI"}
              </span>
              <span class="text-xs font-mono-tech text-text-muted uppercase">
                {isEN ? "PROCUREMENT PROTOCOL" : "STANDARD ZAOPATRZENIA"}
              </span>
            </div>

            <h3 class="text-2xl lg:text-3xl font-bold text-text-primary mb-4 font-heading">
              {tr.eq_sales_pitch_title}
            </h3>

            <p class="text-base text-text-secondary leading-relaxed mb-8">
              {tr.eq_sales_p3}
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
              {
                workflow.map((step) => (
                  <div class="p-4 rounded-lg bg-bg-surface/80 border border-border/70 hover:border-accent/30 transition-colors">
                    <span class="font-mono-tech text-xs font-bold text-accent block mb-1">
                      {step.tag}
                    </span>
                    <h4 class="text-sm font-bold text-text-primary mb-1">
                      {step.title}
                    </h4>
                    <p class="text-xs text-text-secondary leading-relaxed">
                      {step.desc}
                    </p>
                  </div>
                ))
              }
            </div>
          </div>

          <div class="flex flex-col sm:flex-row sm:items-center gap-5 pt-6 border-t border-border/80">
            <Button href="#contact" variant="primary" class="shrink-0">
              {tr.eq_sales_cta}
              <i data-lucide="arrow-right" class="w-4 h-4 ml-1" aria-hidden="true" />
            </Button>

            <div class="text-xs text-text-muted leading-tight">
              <span class="font-semibold text-text-primary block mb-0.5">
                {tr.eq_sales_cta_note}
              </span>
              <span>
                {isEN
                  ? "24h cost estimation, pre-purchase technical verification and turnkey logistics."
                  : "Kalkulacja kosztów z dostawą w 24h, weryfikacja techniczna i obsługa celna."}
              </span>
            </div>
          </div>
        </div>

        <!-- Right: Target Sectors & Sourcing Markets (5 cols) -->
        <div class="lg:col-span-5 flex flex-col justify-between gap-6 lg:border-l lg:border-border/80 lg:pl-10">
          <div>
            <div class="flex items-center justify-between mb-3.5 pb-2 border-b border-border/60">
              <span class="font-mono-tech text-xs font-bold text-text-primary uppercase tracking-wider">
                {tr.eq_sales_target_title}
              </span>
              <span class="badge-tech">B2B SEGMENTS</span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-1 gap-2.5">
              {
                tr.eq_sales_target_items.map((item: string, idx: number) => (
                  <div class="flex items-center gap-3 px-3.5 py-2.5 rounded-lg bg-bg-surface border border-border/70 text-sm text-text-secondary">
                    <i
                      data-lucide={targetIcons[idx % targetIcons.length]}
                      class="w-4 h-4 text-accent shrink-0"
                      aria-hidden="true"
                    />
                    <span class="font-medium">{item}</span>
                  </div>
                ))
              }
            </div>
          </div>

          <div>
            <div class="flex items-center justify-between mb-3.5 pb-2 border-b border-border/60">
              <span class="font-mono-tech text-xs font-bold text-text-primary uppercase tracking-wider">
                {tr.eq_sales_markets_title}
              </span>
              <span class="font-mono-tech text-xs text-accent">GLOBAL COVERAGE</span>
            </div>

            <div class="space-y-2">
              {
                sourcingMarkets.map((m) => (
                  <div class="px-3.5 py-2.5 rounded-lg bg-bg-surface border border-border/70 flex items-center justify-between gap-3">
                    <div class="min-w-0">
                      <span class="text-sm font-bold text-text-primary block">
                        {m.name}
                      </span>
                      <span class="text-xs text-text-muted truncate block">
                        {m.scope}
                      </span>
                    </div>
                    <span class="badge-tech font-mono-tech shrink-0">
                      {m.tag}
                    </span>
                  </div>
                ))
              }
            </div>
          </div>

        </div>

      </div>
    </div>
  </div>
</section>
