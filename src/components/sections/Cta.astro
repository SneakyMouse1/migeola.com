---
import Button from "../ui/Button.astro";

const { tr } = Astro.props;
---

<section class="cta-section relative w-full py-14 lg:py-20 overflow-hidden">
  <!-- Ambient center glow -->
  <div class="cta-glow pointer-events-none absolute inset-0" aria-hidden="true">
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-12 w-full">
    <div
      class="flex flex-col lg:flex-row lg:items-center justify-between gap-8 lg:gap-16"
      data-reveal
    >
      <!-- Left text content -->
      <div class="max-w-3xl">
        <div
          class="inline-flex items-center gap-2 text-xs font-mono-tech font-semibold text-blue-400 tracking-wider uppercase mb-3.5 px-3 py-1 rounded-md bg-blue-500/10 border border-blue-400/25"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-blue-400 animate-pulse"
          ></span>
          <span>{tr.cta_badge ?? "// RAPID ROUTE DISPATCH"}</span>
        </div>

        <h2
          class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white tracking-tight leading-tight mb-3"
        >
          {tr.cta_title}
        </h2>

        <p
          class="text-sm sm:text-base text-slate-300 leading-relaxed max-w-2xl"
        >
          {tr.cta_desc}
        </p>
      </div>

      <!-- Right CTA action button -->
      <div class="shrink-0 flex items-center">
        <Button
          href="#contact"
          variant="primary"
          class="w-full sm:w-auto text-base font-semibold px-8 py-4 rounded-xl shadow-xl shadow-blue-600/30 hover:shadow-blue-600/50 hover:scale-[1.02] active:scale-[0.99] transition-all duration-200 group bg-blue-600 hover:bg-blue-500 text-white border-0"
        >
          <span>{tr.cta_btn}</span>
          <span
            class="inline-block ml-2 text-lg transition-transform duration-200 group-hover:translate-x-1.5"
            >→</span
          >
        </Button>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-section {
    background: linear-gradient(180deg, #0e172a 0%, #090e1a 100%);
    border-top: 1px solid rgba(59, 130, 246, 0.2);
    border-bottom: 1px solid rgba(59, 130, 246, 0.15);
    box-shadow: inset 0 1px 0 0 rgba(255, 255, 255, 0.06);
  }

  .cta-glow {
    background: radial-gradient(
      ellipse 80% 70% at 50% 50%,
      rgba(37, 99, 235, 0.15) 0%,
      transparent 75%
    );
  }

  :global([data-theme="light"]) .cta-section {
    background: linear-gradient(180deg, #eff6ff 0%, #e2eefd 100%);
    border-top: 1px solid rgba(37, 99, 235, 0.18);
    border-bottom: 1px solid rgba(37, 99, 235, 0.18);
    box-shadow: inset 0 1px 0 0 rgba(255, 255, 255, 0.9);
  }

  :global([data-theme="light"]) .cta-section h2 {
    color: #0f172a;
  }

  :global([data-theme="light"]) .cta-section p {
    color: #334155;
  }

  :global([data-theme="light"]) .cta-section .inline-flex {
    color: #1d4ed8;
    background: rgba(37, 99, 235, 0.08);
    border-color: rgba(37, 99, 235, 0.25);
  }

  :global([data-theme="light"]) .cta-section .inline-flex span:first-child {
    background: #2563eb;
  }
</style>
