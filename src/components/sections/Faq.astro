---
import SectionHeader from "../ui/SectionHeader.astro";
import FaqItem from "../ui/FaqItem.astro";

const { tr } = Astro.props;
---

<section id="faq" class="py-20 lg:py-28 bg-bg-surface">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <div data-reveal>
      <SectionHeader
        label={tr.faq_label}
        title={tr.faq_title}
        align="center"
      />
    </div>

    <div
      class="max-w-3xl mx-auto rounded-xl border px-6 bg-bg-card border-border"
      style="box-shadow: var(--shadow-card);"
      data-reveal
    >
      {tr.faqs.map((item) => (
        <FaqItem question={item.q} answer={item.a} />
      ))}
    </div>
  </div>
</section>
