---
const { tr } = Astro.props;

const stats = [
  {
    code: 'OPERATIONS',
    value: tr.strip_stat_1_val ?? '47+',
    label: tr.strip_stat_1_lbl ?? tr.strip_stat_1 ?? 'Zrealizowanych projektów',
    detail: 'Pełen cykl spedycyjny',
  },
  {
    code: 'NETWORK',
    value: tr.strip_stat_2_val ?? '4',
    label: tr.strip_stat_2_lbl ?? tr.strip_stat_2 ?? 'Kontynenty operacji',
    detail: 'Europa, Azja, ME, Ameryka',
  },
  {
    code: 'SEGMENT',
    value: tr.strip_stat_3_val ?? 'B2B',
    label: tr.strip_stat_3_lbl ?? tr.strip_stat_3 ?? 'Dedykowana obsługa firm',
    detail: 'Bezpośrednie umowy i partnerzy',
  },
  {
    code: 'DISPATCH',
    value: tr.strip_stat_4_val ?? '1',
    label: tr.strip_stat_4_lbl ?? tr.strip_stat_4 ?? 'Dedykowany spedytor',
    detail: 'Punkt kontaktu door-to-door',
  },
];
---

<section class="relative z-20 bg-bg-surface/90 border-y border-border backdrop-blur-md">
  <div class="max-w-7xl mx-auto px-6 lg:px-12 py-8 lg:py-10">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 divide-y sm:divide-y-0 sm:divide-x divide-border/80 border border-border/80 rounded-xl bg-bg-card/40 overflow-hidden shadow-sm">
      {stats.map((stat) => (
        <div class="p-6 lg:p-7 flex flex-col justify-between hover:bg-bg-card/70 transition-colors">
          <div class="flex items-center justify-between gap-2 mb-4">
            <span class="font-mono-tech text-xs font-semibold tracking-wider text-accent uppercase">
              // {stat.code}
            </span>
          </div>
          <div>
            <div class="text-3xl lg:text-4xl font-extrabold text-text-primary tracking-tight font-mono-tech mb-2">
              {stat.value}
            </div>
            <div class="text-sm font-semibold text-text-primary leading-snug">
              {stat.label}
            </div>
            <div class="text-xs text-text-muted mt-1.5">
              {stat.detail}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

