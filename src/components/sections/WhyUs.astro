---
import SectionHeader from "../ui/SectionHeader.astro";
import WhyCard from "../ui/WhyCard.astro";

const { tr } = Astro.props;

const icons = [
  "git-merge",
  "package-search",
  "workflow",
  "network",
  "shuffle",
  "user-check",
];
---

<section class="py-20 lg:py-28 bg-bg-base">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <div data-reveal>
      <SectionHeader label={tr.why_label} title={tr.why_title} align="center" />
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
      {
        tr.why_items.map((item: any, i: number) => (
          <div data-reveal data-delay={`${(i % 3) * 100}`}>
            <WhyCard
              title={item.title}
              desc={item.desc}
              icon={icons[i] ?? "check-circle"}
            />
          </div>
        ))
      }
    </div>
  </div>
</section>
