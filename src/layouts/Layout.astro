---
import "../styles/global.css";
import "flag-icons/css/flag-icons.min.css";
import { ClientRouter } from "astro:transitions";

const {
  title,
  description = "",
  lang = "pl",
  canonical: canonicalProp,
} = Astro.props;

const siteUrl = "https://migeola.com";
const canonical = canonicalProp ?? `${siteUrl}${Astro.url.pathname}`;

const plUrl = Astro.props.plUrl ?? "https://migeola.com/";
const enUrl = Astro.props.enUrl ?? "https://migeola.com/en/";
---

<!doctype html>
<html lang={lang}>
  <head>
    <ClientRouter />

    <!-- Anti-flash: Synchronous theme application before initial paint -->
    <script is:inline>
      (function() {
        const stored = localStorage.getItem("theme");
        const system = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        const theme = stored ?? system;
        document.documentElement.setAttribute("data-theme", theme);
        if (theme === "dark") {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      })();
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- AI / LLM Context -->
    <link
      rel="alternate"
      type="text/markdown"
      href="/llms.txt"
      title="LLMs.txt"
    />
    <link
      rel="alternate"
      type="text/markdown"
      href="/llms-full.txt"
      title="LLMs-full.txt"
    />

    <!-- Canonical -->
    <link rel="canonical" href={canonical} />

    <!-- Hreflang -->
    <link rel="alternate" hreflang="pl" href={plUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={plUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Migeola" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}/og-image.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="International logistics company based in Poland providing global freight and equipment sourcing services"
    />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/og-image.jpg`} />

    <!-- Fonts: Space Grotesk (заголовки) + Inter (интерфейс/текст) + JetBrains Mono (технические метки) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Structured Data -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Organization",
        "@id": "https://migeola.com/#organization",
        name: "Migeola",
        url: "https://migeola.com",
        logo: "https://migeola.com/android-chrome-512x512.png",
        image: "https://migeola.com/og-image.jpg",
        description:
          "International freight forwarding, project cargo transport and equipment sourcing for B2B clients.",
        telephone: "+48666557461",
        email: "info@migeola.com",
        address: {
          "@type": "PostalAddress",
          streetAddress: "ul. Ostrobramska 101",
          postalCode: "04-041",
          addressLocality: "Warszawa",
          addressCountry: "PL",
        },
        areaServed: ["Europe", "Asia", "Middle East", "Americas"],
        serviceType: [
          "International logistics",
          "Freight forwarding",
          "Project cargo transport",
          "Equipment sourcing",
          "Industrial supply chain",
        ],
        contactPoint: {
          "@type": "ContactPoint",
          telephone: "+48666557461",
          contactType: "customer service",
          availableLanguage: ["English", "Polish"],
        },
      })}
    />

    <title>{title}</title>
  </head>
  <body>
    <slot />

    <!-- Lucide Icons CDN -->
    <script src="https://unpkg.com/lucide@latest" defer></script>

    <!-- Core client logic (bundled & optimized by Vite) -->
    <script>
      import { initReveal } from "../scripts/reveal.js";
      import { initIcons } from "../scripts/icons.js";
      import { restoreScrollPosition } from "../scripts/navigation.js";
      import { applyTheme } from "../scripts/theme.js";

      function onPageLoad() {
        initReveal();
        initIcons();
        restoreScrollPosition();
      }

      onPageLoad();
      document.addEventListener("astro:page-load", onPageLoad);
      document.addEventListener("astro:after-swap", () => {
        applyTheme();
        restoreScrollPosition();
      });
    </script>

    <!-- CookieHub -->
    <script src="https://cdn.cookiehub.eu/c2/82bf8ca7.js"></script>
    <script type="text/javascript">
      document.addEventListener("DOMContentLoaded", function (event) {
        var cpm = {};
        window.cookiehub.load(cpm);
      });
    </script>
  </body>
</html>
