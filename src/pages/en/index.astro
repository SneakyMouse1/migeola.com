---
import Layout from "../../layouts/Layout.astro";
import PageContent from "../../components/PageContent.astro";
import { t } from "../../i18n/translations";

const lang = "en";
const tr = t.en;
---

<Layout 
  title={tr.meta_title} 
  description={tr.meta_description} 
  lang={lang}
  canonical="https://migeola.com/en/"
  plUrl="https://migeola.com/"
  enUrl="https://migeola.com/en/"
>
  <PageContent lang={lang} tr={tr} />
</Layout>
